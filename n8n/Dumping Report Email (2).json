            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"from\": \"GRIP Alerts <alerts@grip-goa.online>\",\n  \"to\": [\"{{ $json.contact_email }}\"],\n  \"subject\": \"URGENT: New Illegal Dumping Report in {{ $json.department_name }}\",\n  \"html\": \"<div style=\\\"font-family: sans-serif; padding: 20px; background-color: #f8fafc;\\\">\\n  <div style=\\\"background-color: #ffffff; padding: 30px; border-radius: 10px; max-width: 600px; margin: 0 auto; border-top: 5px solid #059669;\\\">\\n    <h2 style=\\\"color: #0f172a; margin-top: 0;\\\">New Environmental Report Logged</h2>\\n    <p style=\\\"color: #475569;\\\">Dear {{ $json.officer_in_charge || 'Panchayat Secretary' }},</p>\\n    <p style=\\\"color: #475569;\\\">A citizen has just reported an illegal dumping incident within your jurisdiction.</p>\\n    <div style=\\\"background-color: #f1f5f9; padding: 15px; border-radius: 8px; margin: 20px 0;\\\">\\n      <p style=\\\"margin: 5px 0;\\\"><strong>Ticket ID:</strong> {{ $('Supabase Webhook').item.json.body.record.id.split('-')[0] }}</p>\\n      <p style=\\\"margin: 5px 0;\\\"><strong>Issue Type:</strong> <span style=\\\"text-transform: capitalize;\\\">{{ $('Supabase Webhook').item.json.body.record.issue_type.replace(/_/g, ' ') }}</span></p>\\n      <p style=\\\"margin: 5px 0;\\\"><strong>SLA Deadline:</strong> {{ new Date($('Supabase Webhook').item.json.body.record.escalation_deadline).toLocaleDateString() }}</p>\\n    </div>\\n    <p style=\\\"color: #475569;\\\">Please log in to the GRIP Dashboard to view the geographic coordinates, AI severity assessment, and photographic evidence. Failure to initiate cleanup within the SLA timeframe will result in automatic escalation to the Block Development Officer.</p>\\n    <a href=\\\"https://www.grip-goa.online/panchayat/pending\\\" style=\\\"display: inline-block; background-color: #059669; color: #ffffff; padding: 12px 24px; text-decoration: none; border-radius: 6px; font-weight: bold; margin-top: 10px;\\\">Access GRIP Dashboard</a>\\n  </div>\\n</div>\"\n}",
        "options": {}
      },
