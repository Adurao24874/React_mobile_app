    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  d.contact_email, \n  d.department_name, \n  d.officer_in_charge\nFROM \n  departments d\nJOIN \n  goa_villages gv ON d.department_name ILIKE '%' || gv.village_name || '%'\nWHERE \n  ST_Contains(gv.geom, ST_SetSRID(ST_MakePoint($1, $2), 4326));",
        "options": {
          "queryReplacement": "={{ [$json.body.record.longitude, $json.body.record.latitude] }}"
        }
      },
      "id": "53ec2419-0b42-42b5-95d2-b12246e07b50",
